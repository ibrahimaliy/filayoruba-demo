# -------------------------------------------------------------
# Fìlà Yorùbá — Showcase / Demo Edition Environment Config
# -------------------------------------------------------------

# Database Connection (Neon Serverless PostgreSQL - Free Tier)
# 1. Create a free project at https://neon.tech
# 2. Paste your pooled connection string (with ?sslmode=require&pgbouncer=true):
DATABASE_URL="postgresql://<user>:<password>@<neon-pooler-host>/neondb?sslmode=require&pgbouncer=true"

# Direct connection string (used for schema push & migrations):
DIRECT_URL="postgresql://<user>:<password>@<neon-direct-host>/neondb?sslmode=require"

# Paystack Payment Gateway (TEST MODE)
# Obtain your test keys from https://dashboard.paystack.com -> Settings -> API Keys & Webhooks:
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key_here"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key_here"

# Base Application URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication & Session Security (Must be different random values)
# Generate via: openssl rand -hex 32 or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD="generate_a_strong_random_password_here"
ADMIN_SECRET_KEY="generate_a_64_char_hex_secret_here"

# Optional: Dedicated throwaway password for portfolio demo / 1-click sandbox access
DEMO_ADMIN_PASSWORD="fila_demo_reviewer_2026"

# Transactional Email via Resend (Optional in local dev - logs to terminal if omitted)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Fìlà Yorùbá <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="demo@filayoruba.com"

# Cloudinary CDN Configuration (Optional - falls back to local uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=