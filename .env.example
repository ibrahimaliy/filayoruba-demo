# -------------------------------------------------------------
# Fìlà Yorùbá — Showcase / Demo Edition Environment Config
# -------------------------------------------------------------

# Database Connection (Neon Serverless PostgreSQL - Free Tier)
# 1. Create a free project at https://neon.tech
# 2. Paste your pooled connection string (with ?sslmode=require&pgbouncer=true):
DATABASE_URL="postgresql://<user>:<password>@<neon-pooler-host>/neondb?sslmode=require&pgbouncer=true"

# Direct connection string (used for schema push & migrations):
DIRECT_URL="postgresql://<user>:<password>@<neon-direct-host>/neondb?sslmode=require"

# Paystack Payment Gateway (TEST MODE)
# Pre-configured with Paystack Test credentials for sandbox checkout:
PAYSTACK_SECRET_KEY="sk_test_5e6ada0f6f70389b7db88598f92c9405c63f00d4"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_cfebb7fbf537f8e6a0cc293df609a2a7be827006"

# Base Application URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication (Default Demo Credentials)
ADMIN_PASSWORD=filayoruba_admin_secret_key_2026
ADMIN_SECRET_KEY=filayoruba_admin_secret_key_2026

# Transactional Email via Resend (Optional in local dev - logs to terminal if omitted)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="Fìlà Yorùbá <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL="demo@filayoruba.com"

# Cloudinary CDN Configuration (Optional - falls back to local uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=